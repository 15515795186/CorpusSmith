# 复制本文件为 .env（.env 已被 .gitignore 忽略，不会进版本库），填入真实 key：
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux/macOS:         cp .env.example .env
#
# 真实环境变量优先于本文件；调试时可直接 $env:DASHSCOPE_API_KEY=...，不会被覆盖。

DASHSCOPE_API_KEY=sk-在此粘贴你的新key
# OPENAI_API_KEY=sk-可选，仅 --llm-provider openai 时需要

# 建议收紧文件权限（Windows）：
#   右键 .env → 安全 → 编辑 → 仅保留当前用户的"读取"